{
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "staging": true
    }
  },
  "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- . ':!docs' ':!AGENTS.md' ':!CLAUDE.md' ':!justfile' ':!.github' ':!.gitignore'",
  "buildCommand": "pip install uv && case \"$VERCEL_ENV\" in production) uv run --frozen alembic upgrade head ;; preview) uv run --frozen python api/preview_db.py ;; esac",
  "crons": [{ "path": "/jobs/w3c-sync", "schedule": "0 4 * * *" }],
  "functions": { "api/index.py": { "maxDuration": 60 } }
}
