# Copy to .env (gitignored). create_app and the just db recipes read it.
TOKEN_TIME=60
REFRESH_TOKEN_TIME=300
W3C_URL=https://website-backend.w3champions.com/api

# Database URLs for `just db <recipe> <path> <env>`; never commit real ones.
LOCAL_DB_URL=postgresql+psycopg://gym_user:gym_user@localhost:5432/gym_backend
VERCEL_PROD_DB_URL=
VERCEL_STAGING_DB_URL=

# The Azure staging box, for `just deploy|logs|status azure staging` and `just db ... azure staging`.
# In the gym root: terraform -chdir=infra output -raw fqdn
AZURE_STAGING_HOST=
