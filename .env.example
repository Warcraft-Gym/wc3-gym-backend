# Copy to .env (gitignored). The just modules read it (set dotenv-load) and api/index.py loads it
# for a bare `uvicorn api.index:app`; create_app and the migrations read the process environment only.
TOKEN_TIME=60
W3C_URL=https://website-backend.w3champions.com/api

# Database URLs the just modules build DB_URL from; never commit real ones.
LOCAL_DB_URL=postgresql+psycopg://gym_user:gym_user@localhost:5432/gym_backend
VERCEL_PROD_DB_URL=
VERCEL_STAGING_DB_URL=

# The Azure staging box, for `just azure deploy|logs|status|alembic|seed`.
# In the gym root: terraform -chdir=infra output -raw fqdn
AZURE_STAGING_HOST=
BLOB_READ_WRITE_TOKEN=

# Game replays live in a Cloudflare R2 bucket: gnl-replays in production, gnl-replays-staging
# on the preview and development targets, each with an R2 API token scoped to it
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=

# The application values api/index.py reads from here, development-only; the README table is the
# full deploy list. `just up` passes the same two secrets to the container.
ADMIN_TOKEN=devtoken
JWT_SECRET_KEY=devsecret
JWT_ALGORITHM=HS256
FRONTEND_URL=http://localhost:5003

# Clerk signs the member sessions; the parties are the origins the frontend serves from
CLERK_SECRET_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:5003

# The Discord guild, its bot and the app that owns the slash commands
DISCORD_GUILD_ID=
ADMIN_DISCORD_IDS=
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=
