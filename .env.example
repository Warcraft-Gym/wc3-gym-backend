# Copy to .env (gitignored). The just modules read it (set dotenv-load) and api/index.py loads it
# for a bare `uvicorn api.index:app`; create_app and the migrations read the process environment only.
TOKEN_TIME=60
W3C_URL=https://website-backend.w3champions.com/api

# Database URLs the just modules build DB_URL from; never commit real ones.
LOCAL_DB_URL=postgresql+psycopg://gym_user:gym_user@localhost:5432/gym_backend
VERCEL_PROD_DB_URL=
VERCEL_STAGING_DB_URL=

# `just db` reads the Supabase metrics endpoint of each project with these; the URLs above give pg_stat_statements.
# The project ref, the subdomain of the project's supabase.co URL
SUPABASE_PROD_PROJECT_REF=
SUPABASE_STAGING_PROJECT_REF=
# The project's secret key, sent as the basic-auth password of user service_role
SUPABASE_PROD_SECRET_KEY=
SUPABASE_STAGING_SECRET_KEY=

# The Azure staging box, for `just azure deploy|logs|status|alembic|seed`.
# In the gym root: terraform -chdir=infra output -raw fqdn
AZURE_STAGING_HOST=

# Team logos and map pictures live in Vercel Blob: gnl-media in production, gnl-media-staging on
# the preview and development targets. A call authenticates with the store id and a Vercel OIDC
# token; `vercel env pull` writes both, and the token lasts 12 hours. `just local seed` and
# `just vercel seed` upload the seed's logos/<team id>.<ext> with them; with no BLOB_STORE_ID the
# load stops after the CSVs and teams keep the default logo.
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=

# Game replays live in a Cloudflare R2 bucket: gnl-replays in production, gnl-replays-staging
# on the preview and development targets, each with an R2 API token scoped to it
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=

# The application values api/index.py reads from here, development-only; the README table is the
# full deploy list. `just up` passes the same development values to the container.
# `just local` builds DB_URL from LOCAL_DB_URL and `just vercel` from the two VERCEL_* URLs above;
# only a bare `uvicorn api.index:app` reads this key.
DB_URL=postgresql+psycopg://gym_user:gym_user@localhost:5432/gym_backend
ADMIN_TOKEN=devtoken
JWT_SECRET_KEY=devsecret
JWT_ALGORITHM=HS256
FRONTEND_URL=http://localhost:5003

# Clerk signs the member sessions; the parties are the origins the frontend serves from
CLERK_SECRET_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:5003

# The Discord guild, its bot and the app that owns the slash commands
DISCORD_GUILD_ID=
ADMIN_DISCORD_IDS=
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=
# Channel webhook for dev alerts (the dev alerts channel), optional: unset means no post
DEV_ALERTS_WEBHOOK_URL=
# Discord user id to tag on an alert, optional: unset means no tag
DEV_ALERTS_MENTION_USER_ID=
